# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/south_sudan_marketplace
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/south_sudan_marketplace?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/south_sudan_marketplace

# Authentication
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=7d

# Default admin seed (npm run seed:admin)
ADMIN_EMAIL=admin@ssmarketplace.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=System Administrator
ADMIN_PHONE=0700000000

# Frontend (CORS)
CLIENT_URL=http://localhost:5173

# M-Pesa Daraja API
# Set MPESA_MOCK_MODE=true when real credentials are unavailable
MPESA_MOCK_MODE=true
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=http://localhost:5000/api/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox

# Cloudinary (optional — product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
